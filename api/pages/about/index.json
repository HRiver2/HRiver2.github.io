{"title":"About","type":"about","uid":"d6fc0d399b19c12496e1fd9b59e8812e","text":" .about-neo { --ab-ink: var(--text-normal); --ab-soft: var(--text-dim); --ab-bright: var(--text-bright); --ab-accent: var(--text-accent); --...","date":"2021-10-30T10:06:05.000Z","updated":"2026-03-09T13:37:39.352Z","comments":true,"path":"api/pages/about/index.json","covers":[],"excerpt":"","content":"\n<section class=\"about-neo\" aria-label=\"about hero\">\n  <style>\n    .about-neo {\n      --ab-ink: var(--text-normal);\n      --ab-soft: var(--text-dim);\n      --ab-bright: var(--text-bright);\n      --ab-accent: var(--text-accent);\n      --ab-card: var(--background-primary);\n      --ab-bg: var(--background-secondary);\n      --ab-line: color-mix(in srgb, var(--text-accent) 22%, transparent);\n      max-width: 1100px;\n      margin: 0 auto;\n      color: var(--ab-ink);\n      font-family: \"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n    }\n\n    .about-shell {\n      position: relative;\n      overflow: hidden;\n      border-radius: 28px;\n      padding: 2rem;\n      background: var(--ab-bg);\n      border: 1px solid color-mix(in srgb, var(--text-accent) 16%, transparent);\n    }\n\n    .about-hero {\n      display: grid;\n      grid-template-columns: 130px 1fr;\n      gap: 1.2rem;\n      align-items: center;\n      margin-bottom: 1.6rem;\n      animation: abFade 0.7s ease both;\n    }\n\n    .about-avatar {\n      width: 130px;\n      height: 130px;\n      border-radius: 32px;\n      object-fit: cover;\n      border: 1px solid color-mix(in srgb, var(--text-accent) 22%, transparent);\n    }\n\n    .about-kicker {\n      margin: 0 0 0.35rem;\n      font-size: 0.84rem;\n      letter-spacing: 0.11em;\n      text-transform: uppercase;\n      color: var(--ab-soft);\n      font-weight: 700;\n    }\n\n    .about-title {\n      margin: 0;\n      font-family: \"Formula1Bold\", \"Noto Sans SC\", sans-serif;\n      font-size: clamp(1.65rem, 4vw, 2.7rem);\n      line-height: 1.06;\n      letter-spacing: 0.01em;\n      color: var(--ab-bright);\n    }\n\n    .about-sub {\n      margin: 0.4rem 0 0;\n      font-size: 1rem;\n      color: var(--ab-soft);\n    }\n\n    .about-tags {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.55rem;\n      margin-bottom: 1.6rem;\n      animation: abFade 0.9s ease both;\n    }\n\n    .about-tag {\n      border: 1px solid var(--ab-line);\n      border-radius: 999px;\n      padding: 0.36rem 0.72rem;\n      font-size: 0.82rem;\n      background: color-mix(in srgb, var(--background-primary) 82%, transparent);\n      color: var(--ab-soft);\n    }\n\n    .about-grid {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 0.9rem;\n      animation: abFade 1.05s ease both;\n    }\n\n    .about-card {\n      position: relative;\n      border-radius: 22px;\n      border: 1px solid var(--ab-line);\n      background: var(--ab-card);\n      overflow: hidden;\n      min-height: 220px;\n      transition: transform 0.25s ease;\n      isolation: isolate;\n    }\n\n    .about-card::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      border-radius: inherit;\n      pointer-events: none;\n      z-index: 5;\n      box-shadow:\n        inset 0 0 0 1px var(--ab-line),\n        inset 0 0 0 3px color-mix(in srgb, var(--ab-card) 86%, transparent);\n    }\n\n    .about-card:hover {\n      transform: translateY(-3px);\n    }\n\n    .about-photo {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      display: block;\n      object-fit: cover;\n      object-position: center;\n      transform: scale(1.03);\n      filter: none;\n      transition: filter 0.35s ease, transform 0.35s ease;\n      z-index: 0;\n      backface-visibility: hidden;\n      -webkit-backface-visibility: hidden;\n      will-change: transform, filter;\n    }\n\n    .about-card:hover .about-photo {\n      filter: blur(4px) brightness(0.82);\n      transform: scale(1.12);\n    }\n\n    .about-inner,\n    .about-hover {\n      position: absolute;\n      inset: 0;\n      padding: 1.15rem 1.2rem;\n      transition: opacity 0.35s ease, transform 0.35s ease;\n    }\n\n    .about-inner {\n      display: flex;\n      flex-direction: column;\n      justify-content: flex-end;\n      gap: 0.45rem;\n      z-index: 2;\n      isolation: isolate;\n    }\n\n    .about-hover {\n      z-index: 3;\n      opacity: 0;\n      visibility: hidden;\n      pointer-events: none;\n      transform: translateY(8px);\n      color: var(--ab-bright);\n      font-size: 0.88rem;\n      line-height: 1.65;\n      overflow: hidden;\n      border-radius: 22px;\n      background: linear-gradient(\n        0deg,\n        color-mix(in srgb, var(--background-secondary) 62%, #000 38%),\n        color-mix(in srgb, var(--background-secondary) 44%, #000 24%)\n      );\n      padding: 1.15rem 1.2rem;\n      text-shadow: 0 1px 2px color-mix(in srgb, var(--background-secondary) 60%, transparent);\n    }\n\n    .about-neo h1::before,\n    .about-neo h1::after,\n    .about-neo h2::before,\n    .about-neo h2::after,\n    .about-neo h3::before,\n    .about-neo h3::after {\n      content: none !important;\n      display: none !important;\n    }\n\n    .about-inner h3,\n    .about-hover b {\n      position: relative;\n      z-index: 1;\n    }\n\n    .about-inner h3 {\n      margin: 0;\n      font-size: 1.05rem;\n      line-height: 1.2;\n      font-family: \"Formula1Bold\", \"Noto Sans SC\", sans-serif;\n      display: inline-block;\n      width: fit-content;\n      padding: 0.28rem 0.5rem;\n      border-radius: 10px;\n      background: color-mix(in srgb, var(--background-primary) 62%, transparent);\n      border: 1px solid color-mix(in srgb, var(--text-accent) 16%, transparent);\n      backdrop-filter: blur(6px);\n      -webkit-backdrop-filter: blur(6px);\n    }\n\n    .about-card:hover .about-hover {\n      opacity: 1;\n      visibility: visible;\n      pointer-events: auto;\n      overflow-y: auto;\n      transform: translateY(0);\n    }\n\n    .about-card:hover .about-inner {\n      opacity: 0;\n    }\n\n    .about-hover b {\n      color: var(--ab-accent);\n    }\n\n    .about-quote {\n      margin-top: 1rem;\n      padding: 1rem 1.1rem;\n      border-radius: 16px;\n      border: 1px dashed color-mix(in srgb, var(--text-accent) 28%, transparent);\n      color: var(--ab-soft);\n      background: color-mix(in srgb, var(--background-primary) 92%, transparent);\n      font-size: 0.9rem;\n      line-height: 1.7;\n    }\n\n    @keyframes abFade {\n      from {\n        opacity: 0;\n        transform: translateY(10px);\n      }\n\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    @media (max-width: 920px) {\n      .about-shell {\n        border-radius: 22px;\n        padding: 1.3rem;\n      }\n\n      .about-hero {\n        grid-template-columns: 96px 1fr;\n      }\n\n      .about-avatar {\n        width: 96px;\n        height: 96px;\n        border-radius: 24px;\n      }\n\n      .about-grid {\n        grid-template-columns: 1fr;\n      }\n\n      .about-card {\n        min-height: 200px;\n      }\n    }\n\n    @media (max-width: 600px) {\n      .about-hover {\n        font-size: 0.84rem;\n      }\n    }\n  </style>\n\n  <div class=\"about-shell\">\n    <header class=\"about-hero\">\n      <img class=\"about-avatar\" src=\"https://pic1.imgdb.cn/item/6991cb5c00a52e056d21cf41.png\" alt=\"Heriko avatar\" />\n      <div>\n        <p class=\"about-kicker\">Observation Hub</p>\n        <h1 class=\"about-title\">Ciallo, welcome to KZOH.</h1>\n        <p class=\"about-sub\">Heriko Deltana / 空奏星鈴 · INFP · 前 OIer · IMM</p>\n      </div>\n    </header>\n\n    <div class=\"about-tags\" aria-label=\"quick tags\">\n      <span class=\"about-tag\">Vocaloid</span>\n      <span class=\"about-tag\">F1</span>\n      <span class=\"about-tag\">CS</span>\n      <span class=\"about-tag\">Daily Logs</span>\n      <span class=\"about-tag\">Long-form Notes</span>\n    </div>\n\n    <div class=\"about-grid\">\n      <article class=\"about-card\">\n        <img class=\"about-photo\" src=\"/about/gallery/ciallo.jpg\" alt=\"ciallo\" />\n        <div class=\"about-inner\">\n          <h3>关于博客</h3>\n        </div>\n        <div class=\"about-hover\">\n          这里是 <b>Heriko Deltana</b> 的个人博客，建立于 <b>2021.10.30</b>。<br />\n          之前有一个博客园站点（已弃用），主要是早期算法记录。<br />\n          现在这里是更自由的文字出口，更新频率不高，但会持续留下观测与日常。<br />\n          内容范围比较宽：Vocaloid、F1、CS、二游等。<br />\n          这个博客平常并不高调宣传，所以很高兴你能来到这里。\n        </div>\n      </article>\n\n      <article class=\"about-card\">\n        <img class=\"about-photo\" src=\"/about/gallery/miku39.jpg\" alt=\"miku\" />\n        <div class=\"about-inner\">\n          <h3>关于作者</h3>\n        </div>\n        <div class=\"about-hover\">\n          <b>作者：</b>Heriko Deltana / 空奏星鈴（简称 HD）<br />\n          <b>站点名：</b>hriver2.github.io 中的 HRiver2 是旧日名称，目前保留用于网址。<br />\n          <b>MBTI：</b>INFP。<br />\n          <b>其他：</b>前 OIer，IMM(2019)。\n        </div>\n      </article>\n\n      <article class=\"about-card\">\n        <img class=\"about-photo\" src=\"/about/gallery/melty.jpg\" alt=\"interest\" />\n        <div class=\"about-inner\">\n          <h3>兴趣谱系</h3>\n        </div>\n        <div class=\"about-hover\">\n          关注点经常横跳，但核心很稳定：<br />\n          喜欢在不同领域里寻找“可被表达的瞬间”。\n        </div>\n      </article>\n\n      <article class=\"about-card\">\n        <img class=\"about-photo\" src=\"/about/gallery/knd.jpg\" alt=\"writing\" />\n        <div class=\"about-inner\">\n          <h3>写作偏好</h3>\n        </div>\n        <div class=\"about-hover\">\n          文字通常更接近“即时观测”：<br />\n          不刻意追求完整叙事，而是保留当时的情绪和判断。\n        </div>\n      </article>\n    </div>\n\n    <div class=\"about-quote\">\n      我一直很好奇人们对别人分享欲的接受程度到底如何，又到底为何去接受。<br />\n      如果你能在这里读到一点文字背后的流动，那么这页 About 的目的就达成了。\n    </div>\n  </div>\n</section>\n\r\n","count_time":{"symbolsCount":"7.7k","symbolsTime":"7 mins."},"toc":"<ol class=\"toc\"><li class=\"toc-item toc-level-1\"><a class=\"toc-link\"><span class=\"toc-text\">Ciallo, welcome to KZOH.</span></a><ol class=\"toc-child\"><li class=\"toc-item toc-level-3\"><a class=\"toc-link\"><span class=\"toc-text\">关于博客</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\"><span class=\"toc-text\">关于作者</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\"><span class=\"toc-text\">兴趣谱系</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\"><span class=\"toc-text\">写作偏好</span></a></li></ol></li></ol></li></ol>","data":[]}