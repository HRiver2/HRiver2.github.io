>x<span class=\"op\">&lt;&lt;</span><span class=\"dv\">3</span><span class=\"op\">)+(</span>x<span class=\"op\">&lt;&lt;</span><span class=\"dv\">1</span><span class=\"op\">)+(</span>c<span class=\"op\">^=</span><span class=\"dv\">48</span><span class=\"op\">);</span></span>\r\n<span id=\"cb9-40\"><a href=\"#cb9-40\" aria-hidden=\"true\" tabindex=\"-1\"></a>        c<span class=\"op\">=</span>getchar<span class=\"op\">();</span></span>\r\n<span id=\"cb9-41\"><a href=\"#cb9-41\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"op\">}</span></span>\r\n<span id=\"cb9-42\"><a href=\"#cb9-42\" aria-hidden=\"true\" tabindex=\"-1\"></a>   </span>\r\n<span id=\"cb9-43\"><a href=\"#cb9-43\" aria-hidden=\"true\" tabindex=\"-1\"></a>    x<span class=\"op\">*=</span>f<span class=\"op\">;</span></span>\r\n<span id=\"cb9-44\"><a href=\"#cb9-44\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"op\">}</span></span>\r\n<span id=\"cb9-45\"><a href=\"#cb9-45\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb9-46\"><a href=\"#cb9-46\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"kw\">template</span><span class=\"op\">&lt;</span><span class=\"kw\">typename</span> J<span class=\"op\">&gt;</span></span>\r\n<span id=\"cb9-47\"><a href=\"#cb9-47\" aria-hidden=\"true\" tabindex=\"-1\"></a>I <span class=\"dt\">void</span> fw<span class=\"op\">(</span>J x<span class=\"op\">,</span><span class=\"dt\">bool</span> k<span class=\"op\">)</span></span>\r\n<span id=\"cb9-48\"><a href=\"#cb9-48\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"op\">{</span></span>\r\n<span id=\"cb9-49\"><a href=\"#cb9-49\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"cf\">if</span><span class=\"op\">(</span>x<span class=\"op\">&lt;</span><span class=\"dv\">0</span><span class=\"op\">)</span></span>\r\n<span id=\"cb9-50\"><a href=\"#cb9-50\" aria-hidden=\"true\" tabindex=\"-1\"></a>        x<span class=\"op\">=-</span>x<span class=\"op\">,</span>putchar<span class=\"op\">(</span><span class=\"ch\">'-'</span><span class=\"op\">);</span></span>\r\n<span id=\"cb9-51\"><a href=\"#cb9-51\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb9-52\"><a href=\"#cb9-52\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"at\">static</span> <span class=\"dt\">short</span> stak<span class=\"op\">[</span><span class=\"dv\">35</span><span class=\"op\">];</span></span>\r\n<span id=\"cb9-53\"><a href=\"#cb9-53\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"dt\">short</span> top<span class=\"op\">(</span><span class=\"dv\">0</span><span class=\"op\">);</span></span>\r\n<span id=\"cb9-54\"><a href=\"#cb9-54\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb9-55\"><a href=\"#cb9-55\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"cf\">do</span></span>\r\n<span id=\"cb9-56\"><a href=\"#cb9-56\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"op\">{</span></span>\r\n<span id=\"cb9-57\"><a href=\"#cb9-57\" aria-hidden=\"true\" tabindex=\"-1\"></a>        stak<span class=\"op\">[</span>top<span class=\"op\">++]=</span>x<span class=\"op\">%</span><span class=\"dv\">10</span><span class=\"op\">;</span></span>\r\n<span id=\"cb9-58\"><a href=\"#cb9-58\" aria-hidden=\"true\" tabindex=\"-1\"></a>        x<span class=\"op\">/=</span><span class=\"dv\">10</span><span class=\"op\">;</span></span>\r\n<span id=\"cb9-59\"><a href=\"#cb9-59\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"op\">}</span></span>\r\n<span id=\"cb9-60\"><a href=\"#cb9-60\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"cf\">while</span><span class=\"op\">(</span>x<span class=\"op\">);</span></span>\r\n<span id=\"cb9-61\"><a href=\"#cb9-61\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb9-62\"><a href=\"#cb9-62\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"cf\">while</span><span class=\"op\">(</span>top<span class=\"op\">)</span></span>\r\n<s