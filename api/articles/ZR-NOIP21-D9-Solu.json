ss=\"op\">{</span></span>\r\n<span id=\"cb1-64\"><a href=\"#cb1-64\" aria-hidden=\"true\" tabindex=\"-1\"></a>        <span class=\"dt\">int</span> x<span class=\"op\">,</span>y<span class=\"op\">;</span></span>\r\n<span id=\"cb1-65\"><a href=\"#cb1-65\" aria-hidden=\"true\" tabindex=\"-1\"></a>        fr<span class=\"op\">(</span>x<span class=\"op\">),</span>fr<span class=\"op\">(</span>y<span class=\"op\">);</span></span>\r\n<span id=\"cb1-66\"><a href=\"#cb1-66\" aria-hidden=\"true\" tabindex=\"-1\"></a>        Matrix tmp<span class=\"op\">;</span></span>\r\n<span id=\"cb1-67\"><a href=\"#cb1-67\" aria-hidden=\"true\" tabindex=\"-1\"></a>        tmp<span class=\"op\">.</span>n<span class=\"op\">=</span>tmp<span class=\"op\">.</span>m<span class=\"op\">=</span>m<span class=\"op\">;</span></span>\r\n<span id=\"cb1-68\"><a href=\"#cb1-68\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb1-69\"><a href=\"#cb1-69\" aria-hidden=\"true\" tabindex=\"-1\"></a>        <span class=\"cf\">for</span><span class=\"op\">(</span><span class=\"dt\">int</span> j<span class=\"op\">(</span><span class=\"dv\">1</span><span class=\"op\">);</span>j<span class=\"op\">&lt;=</span>m<span class=\"op\">;++</span>j<span class=\"op\">)</span></span>\r\n<span id=\"cb1-70\"><a href=\"#cb1-70\" aria-hidden=\"true\" tabindex=\"-1\"></a>            <span class=\"op\">++</span>tmp<span class=\"op\">.</span>a<span class=\"op\">[</span>j<span class=\"op\">][</span>j<span class=\"op\">],++</span>tmp<span class=\"op\">.</span>a<span class=\"op\">[</span>j<span class=\"op\">][(</span>j<span class=\"op\">+</span>y<span class=\"op\">-</span><span class=\"dv\">1</span><span class=\"op\">)%</span>m<span class=\"op\">+</span><span class=\"dv\">1</span><span class=\"op\">];</span></span>\r\n<span id=\"cb1-71\"><a href=\"#cb1-71\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb1-72\"><a href=\"#cb1-72\" aria-hidden=\"true\" tabindex=\"-1\"></a>        ans<span class=\"op\">=<