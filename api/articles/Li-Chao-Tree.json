pan class=\"op\">;</span></span>\r\n<span id=\"cb1-43\"><a href=\"#cb1-43\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"op\">}</span></span>\r\n<span id=\"cb1-44\"><a href=\"#cb1-44\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb1-45\"><a href=\"#cb1-45\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"kw\">template</span><span class=\"op\">&lt;</span><span class=\"kw\">typename</span> J<span class=\"op\">&gt;</span></span>\r\n<span id=\"cb1-46\"><a href=\"#cb1-46\" aria-hidden=\"true\" tabindex=\"-1\"></a>I <span class=\"dt\">void</span> fw<span class=\"op\">(</span>J x<span class=\"op\">,</span><span class=\"dt\">bool</span> k<span class=\"op\">)</span> <span class=\"op\">{</span></span>\r\n<span id=\"cb1-47\"><a href=\"#cb1-47\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"cf\">if</span><span class=\"op\">(</span>x<span class=\"op\">&lt;</span><span class=\"dv\">0</span><span class=\"op\">)</span></span>\r\n<span id=\"cb1-48\"><a href=\"#cb1-48\" aria-hidden=\"true\" tabindex=\"-1\"></a>        x<span class=\"op\">=-</span>x<span class=\"op\">,</span>putchar<span class=\"op\">(</span><span class=\"ch\">'-'</span><span class=\"op\">);</span></span>\r\n<span id=\"cb1-49\"><a href=\"#cb1-49\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb1-50\"><a href=\"#cb1-50\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"at\">static</span> <span class=\"dt\">short</span> stak<span class=\"op\">[</span><span class=\"dv\">35</span><span class=\"op\">];</span></span>\r\n<span id=\"cb1-51\"><a href=\"#cb1-51\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"dt\">short</span> top<span class=\"op\">(</span><span class=\"dv\">0</span><span class=\"op\">);</span></span>\r\n<span id=\"cb1-52\"><a href=\"#cb1-52\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb1-53\"><a href=\"#cb1-53\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"cf\">do</span> <span class=\"op\