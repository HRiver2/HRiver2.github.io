\"#cb1-16\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"pp\">#define CL </span><span class=\"at\">const</span><span class=\"pp\"> </span><span class=\"dt\">long</span><span class=\"pp\"> </span><span class=\"dt\">long</span></span>\r\n<span id=\"cb1-17\"><a href=\"#cb1-17\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"pp\">#define mkp</span><span class=\"op\">(</span>a<span class=\"op\">,</span>b<span class=\"op\">)</span><span class=\"pp\"> </span>make_pair<span class=\"op\">(</span>a<span class=\"op\">,</span>b<span class=\"op\">)</span></span>\r\n<span id=\"cb1-18\"><a href=\"#cb1-18\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"pp\">#define mst</span><span class=\"op\">(</span>a<span class=\"op\">,</span>b<span class=\"op\">)</span><span class=\"pp\"> </span>memset<span class=\"op\">(</span>a<span class=\"op\">,</span>b<span class=\"op\">,</span><span class=\"kw\">sizeof</span><span class=\"op\">(</span>a<span class=\"op\">))</span></span>\r\n<span id=\"cb1-19\"><a href=\"#cb1-19\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"pp\">#define ON </span><span class=\"bu\">std::</span>ios<span class=\"bu\">::</span>sync_with_stdio<span class=\"op\">(</span><span class=\"kw\">false</span><span class=\"op\">);</span>cin<span class=\"op\">.</span>tie<span class=\"op\">(</span><span class=\"dv\">0</span><span class=\"op\">)</span></span>\r\n<span id=\"cb1-20\"><a href=\"#cb1-20\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"pp\">#define Files</span><span class=\"op\">()</span><span class=\"pp\"> </span>freopen<span class=\"op\">(</span><span class=\"st\">\"RNMTQ.in\"</span><span class=\"op\">,</span><span class=\"st\">\"r\"</span><span class=\"op\">,</span>stdin<span class=\"op\">);</span>freopen<span class=\"op\">(</span><span class=\"st\">\"RNMTQ.out\"</span><span class=\"op\">,</span><span class=\"st\">\"w\"</span><span class=\"op\">,</span>stdout<span class=\"op\">)</span></span>\r\n<span id=\"cb1-21\"><a href=\"#cb1-21\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb1-22\"><a href=\"#cb1-22\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"kw\">using</span> <span class=\"kw\">namespace</span> std<span class=\"op\">;</span></span>\r\n<span id=\"cb1-23\"><a href=\"#cb1-23\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb1-24\"><a href=\"#cb1-24\" aria-hidden=\"true\" tabindex=\"-1\"></a><span class=\"kw\">template</span><span class=\"op\">&lt;</span><span class=\"kw\">typename</span> J<span class=\"op\">&gt;</span></span>\r\n<span id=\"cb1-25\"><a href=\"#cb1-25\" aria-hidden=\"true\" tabindex=\"-1\"></a>I <span class=\"dt\">void</span> fr<span class=\"op\">(</span>J <span class=\"op\">&amp;</span>x<span class=\"op\">)</span> <span class=\"op\">{</span></span>\r\n<span id=\"cb1-26\"><a href=\"#cb1-26\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"dt\">short</span> f<span class=\"op\">(</span><span class=\"dv\">1</span><span class=\"op\">);</span></span>\r\n<span id=\"cb1-27\"><a href=\"#cb1-27\" aria-hidden=\"true\" tabindex=\"-1\"></a>    x<span class=\"op\">=</span><span class=\"dv\">0</span><span class=\"op\">;</span></span>\r\n<span id=\"cb1-28\"><a href=\"#cb1-28\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"dt\">char</span> c<span class=\"op\">(</span>getchar<span class=\"op\">());</span></span>\r\n<span id=\"cb1-29\"><a href=\"#cb1-29\" aria-hidden=\"true\" tabindex=\"-1\"></a></span>\r\n<span id=\"cb1-30\"><a href=\"#cb1-30\" aria-hidden=\"true\" tabindex=\"-1\"></a>    <span class=\"cf\">while</span><span class=\"op\">(</span>c<span class=\"op\">&lt;</span><span class=\"ch\">'0'</span> <span class=\"kw\">or</span> c<span class=\"op\">&gt;</span><span class=\"ch\">'9'</span><span class=\"op\">)</span> <span class=\"op\">{</span></span>\r\n<span id=\"cb1-31\"><a href=\"#cb1-31\" aria-hidden=\"true\" tabindex=\"-1\"></a>        <span class=\"cf\">if</span><span class=\"op\">(</span>c<span class=\"op\"